{
  "$defs": {
    "CatalogDependency": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CatalogKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "CatalogDependency",
      "type": "object"
    },
    "CatalogItemStatus": {
      "enum": [
        "verified",
        "candidate"
      ],
      "title": "CatalogItemStatus",
      "type": "string"
    },
    "CatalogKind": {
      "enum": [
        "element",
        "instruction"
      ],
      "title": "CatalogKind",
      "type": "string"
    },
    "CatalogLockItem": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "copied_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Copied At"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/CatalogDependency"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CatalogKind"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/CatalogSourceType"
        },
        "status": {
          "$ref": "#/$defs/CatalogItemStatus"
        },
        "target_path": {
          "minLength": 1,
          "title": "Target Path",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "status",
        "source_type",
        "source_path",
        "target_path",
        "content_hash"
      ],
      "title": "CatalogLockItem",
      "type": "object"
    },
    "CatalogSourceType": {
      "enum": [
        "repository",
        "application_candidate"
      ],
      "title": "CatalogSourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/CatalogLockItem"
      },
      "title": "Items",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "title": "CatalogLock",
  "type": "object"
}
