{
  "$defs": {
    "AuthorizationRequirements": {
      "additionalProperties": false,
      "properties": {
        "live_requires_separate_authorization": {
          "default": true,
          "title": "Live Requires Separate Authorization",
          "type": "boolean"
        },
        "live_scope_fields": {
          "items": {
            "type": "string"
          },
          "title": "Live Scope Fields",
          "type": "array"
        },
        "real_browser_requires_authorization": {
          "default": true,
          "title": "Real Browser Requires Authorization",
          "type": "boolean"
        }
      },
      "title": "AuthorizationRequirements",
      "type": "object"
    },
    "ConfirmationStatus": {
      "enum": [
        "open",
        "resolved"
      ],
      "title": "ConfirmationStatus",
      "type": "string"
    },
    "ElementResolutionStatus": {
      "enum": [
        "unresolved",
        "candidate",
        "resolved"
      ],
      "title": "ElementResolutionStatus",
      "type": "string"
    },
    "InstructionResolutionStatus": {
      "enum": [
        "unresolved",
        "candidate",
        "resolved"
      ],
      "title": "InstructionResolutionStatus",
      "type": "string"
    },
    "PendingConfirmation": {
      "additionalProperties": false,
      "properties": {
        "blocks_push": {
          "default": true,
          "title": "Blocks Push",
          "type": "boolean"
        },
        "blocks_review": {
          "default": true,
          "title": "Blocks Review",
          "type": "boolean"
        },
        "blocks_test": {
          "default": true,
          "title": "Blocks Test",
          "type": "boolean"
        },
        "developer_conclusion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Developer Conclusion"
        },
        "id": {
          "pattern": "^PC-[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "requirement_step": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Requirement Step",
          "type": "string"
        },
        "risk": {
          "minLength": 1,
          "title": "Risk",
          "type": "string"
        },
        "source_image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Image"
        },
        "source_location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Location"
        },
        "status": {
          "$ref": "#/$defs/ConfirmationStatus",
          "default": "open"
        }
      },
      "required": [
        "id",
        "requirement_step",
        "question",
        "risk"
      ],
      "title": "PendingConfirmation",
      "type": "object"
    },
    "RequirementApplication": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "App Id",
          "type": "string"
        },
        "app_slug": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "App Slug",
          "type": "string"
        },
        "entrypoint": {
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]*:[a-zA-Z_][a-zA-Z0-9_]*$",
          "title": "Entrypoint",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "app_id",
        "app_slug",
        "name",
        "version",
        "entrypoint"
      ],
      "title": "RequirementApplication",
      "type": "object"
    },
    "RequirementLoop": {
      "additionalProperties": false,
      "description": "A declarative loop; business code decides how its source is resolved.",
      "properties": {
        "item_name": {
          "minLength": 1,
          "title": "Item Name",
          "type": "string"
        },
        "max_iterations": {
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "item_name",
        "source",
        "max_iterations"
      ],
      "title": "RequirementLoop",
      "type": "object"
    },
    "RequirementOutput": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "side_effect": {
          "$ref": "#/$defs/SideEffect",
          "default": "write"
        },
        "success_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Success Conditions",
          "type": "array"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "unique_keys": {
          "items": {
            "type": "string"
          },
          "title": "Unique Keys",
          "type": "array"
        },
        "write_mode": {
          "minLength": 1,
          "title": "Write Mode",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "target",
        "write_mode"
      ],
      "title": "RequirementOutput",
      "type": "object"
    },
    "RequirementSource": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Url"
        },
        "requirement_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Requirement Hash",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "document_id",
        "revision",
        "requirement_hash"
      ],
      "title": "RequirementSource",
      "type": "object"
    },
    "RequirementStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "element_refs": {
          "items": {
            "type": "string"
          },
          "title": "Element Refs",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "instruction_refs": {
          "items": {
            "type": "string"
          },
          "title": "Instruction Refs",
          "type": "array"
        },
        "loop": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequirementLoop"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        },
        "pending_confirmation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Pending Confirmation Ids",
          "type": "array"
        },
        "recovery": {
          "items": {
            "type": "string"
          },
          "title": "Recovery",
          "type": "array"
        },
        "resume": {
          "$ref": "#/$defs/ResumePolicy",
          "default": "verify_then_run"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy"
        },
        "side_effect": {
          "$ref": "#/$defs/SideEffect",
          "default": "none"
        },
        "success_conditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Success Conditions",
          "type": "array"
        },
        "timeout_seconds": {
          "default": 30.0,
          "exclusiveMinimum": 0.0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "unresolved_element_ids": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Element Ids",
          "type": "array"
        },
        "unresolved_instruction_ids": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Instruction Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "action",
        "success_conditions"
      ],
      "title": "RequirementStep",
      "type": "object"
    },
    "ResumePolicy": {
      "enum": [
        "verify_then_run",
        "always_run",
        "manual"
      ],
      "title": "ResumePolicy",
      "type": "string"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "description": "Bounded retry settings used by both requirement and runtime steps.",
      "properties": {
        "backoff_multiplier": {
          "default": 1.0,
          "minimum": 1.0,
          "title": "Backoff Multiplier",
          "type": "number"
        },
        "delay_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Delay Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "retryable_errors": {
          "items": {
            "type": "string"
          },
          "title": "Retryable Errors",
          "type": "array"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    },
    "SideEffect": {
      "enum": [
        "none",
        "read",
        "write"
      ],
      "title": "SideEffect",
      "type": "string"
    },
    "TestRequirements": {
      "additionalProperties": false,
      "properties": {
        "external_write_preview_required": {
          "default": true,
          "title": "External Write Preview Required",
          "type": "boolean"
        },
        "real_browser_authorization_required": {
          "default": true,
          "title": "Real Browser Authorization Required",
          "type": "boolean"
        },
        "real_browser_required": {
          "default": true,
          "title": "Real Browser Required",
          "type": "boolean"
        },
        "required_suites": {
          "items": {
            "type": "string"
          },
          "title": "Required Suites",
          "type": "array"
        }
      },
      "title": "TestRequirements",
      "type": "object"
    },
    "UnresolvedElement": {
      "additionalProperties": false,
      "properties": {
        "blocks_push": {
          "default": true,
          "title": "Blocks Push",
          "type": "boolean"
        },
        "blocks_review": {
          "default": true,
          "title": "Blocks Review",
          "type": "boolean"
        },
        "blocks_test": {
          "default": true,
          "title": "Blocks Test",
          "type": "boolean"
        },
        "id": {
          "pattern": "^UE-[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "page": {
          "minLength": 1,
          "title": "Page",
          "type": "string"
        },
        "platform": {
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "requirement_step": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Requirement Step",
          "type": "string"
        },
        "resolution": {
          "minLength": 1,
          "title": "Resolution",
          "type": "string"
        },
        "resolved_element_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Element Ref"
        },
        "screenshot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screenshot"
        },
        "status": {
          "$ref": "#/$defs/ElementResolutionStatus",
          "default": "unresolved"
        },
        "tested": {
          "default": false,
          "title": "Tested",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "requirement_step",
        "platform",
        "page",
        "name",
        "reason",
        "resolution"
      ],
      "title": "UnresolvedElement",
      "type": "object"
    },
    "UnresolvedInstruction": {
      "additionalProperties": false,
      "description": "A missing reusable capability retained inside a complete V2 flow.",
      "properties": {
        "blocks_offline_test": {
          "default": false,
          "title": "Blocks Offline Test",
          "type": "boolean"
        },
        "blocks_push": {
          "default": true,
          "title": "Blocks Push",
          "type": "boolean"
        },
        "blocks_real_run": {
          "default": true,
          "title": "Blocks Real Run",
          "type": "boolean"
        },
        "blocks_review": {
          "default": true,
          "title": "Blocks Review",
          "type": "boolean"
        },
        "candidate_implementation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Implementation"
        },
        "candidate_instruction_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Instruction Ref"
        },
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "fake_test_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fake Test Ref"
        },
        "fake_test_status": {
          "$ref": "#/$defs/VerificationStatus",
          "default": "not_run"
        },
        "id": {
          "pattern": "^UI-[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "platform": {
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "real_test_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Real Test Evidence"
        },
        "real_test_status": {
          "$ref": "#/$defs/VerificationStatus",
          "default": "not_run"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "requirement_step": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Requirement Step",
          "type": "string"
        },
        "resolved_instruction_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Instruction Ref"
        },
        "status": {
          "$ref": "#/$defs/InstructionResolutionStatus",
          "default": "unresolved"
        }
      },
      "required": [
        "id",
        "requirement_step",
        "platform",
        "capability",
        "reason"
      ],
      "title": "UnresolvedInstruction",
      "type": "object"
    },
    "VerificationStatus": {
      "enum": [
        "not_run",
        "passed",
        "failed"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Canonical requirement contract persisted in Markdown and JSON.",
  "properties": {
    "application": {
      "$ref": "#/$defs/RequirementApplication"
    },
    "authorization_requirements": {
      "$ref": "#/$defs/AuthorizationRequirements"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/RequirementOutput"
      },
      "title": "Outputs",
      "type": "array"
    },
    "pending_confirmations": {
      "items": {
        "$ref": "#/$defs/PendingConfirmation"
      },
      "title": "Pending Confirmations",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "enum": [
        1,
        2
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/RequirementSource"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/RequirementStep"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "test_requirements": {
      "$ref": "#/$defs/TestRequirements"
    },
    "unresolved_elements": {
      "items": {
        "$ref": "#/$defs/UnresolvedElement"
      },
      "title": "Unresolved Elements",
      "type": "array"
    },
    "unresolved_instructions": {
      "items": {
        "$ref": "#/$defs/UnresolvedInstruction"
      },
      "title": "Unresolved Instructions",
      "type": "array"
    }
  },
  "required": [
    "source",
    "application",
    "steps"
  ],
  "title": "RequirementSpec",
  "type": "object"
}
